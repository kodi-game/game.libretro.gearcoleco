msgctxt "Addon Summary"
msgid "Coleco - ColecoVision (Gearcoleco)"
msgstr "Coleco - ColecoVision (Gearcoleco)"

msgctxt "Addon Description"
msgid "Gearcoleco is an open source, cross-platform, ColecoVision emulator."
msgstr "Gearcoleco je multiplatformní open-source emulátor ColecoVision."

msgctxt "#30001"
msgid "Refresh Rate (restart)"
msgstr "Obnovovací frekvence (vyžaduje restart)"

msgctxt "#30002"
msgid "Allow Up+Down / Left+Right"
msgstr "Povolit nahoru+dolů / doleva+doprava"

msgctxt "#30003"
msgid "No Sprite Limit"
msgstr "Bez limitu spritů"

msgctxt "#30005"
msgid "Overscan"
msgstr "Overscan"

msgctxt "#30007"
msgid "Spinner Sensitivity"
msgstr "Citlivost spinneru"

msgctxt "#30008"
msgid "Aspect Ratio"
msgstr "Poměr stran"

msgctxt "#30009"
msgid "Spinner Support"
msgstr "Podpora spinneru"

msgctxt "#30010"
msgid "Mapper (restart)"
msgstr "Mapper (vyžaduje restart)"

msgctxt "#30011"
msgid "System"
msgstr "Systém"

msgctxt "#30012"
msgid "Configure refresh rate and other system-level settings."
msgstr "Nastaví obnovovací frekvenci a další nastavení na úrovni systému."

msgctxt "#30013"
msgid "Select which refresh rate will be used in emulation. 'Auto' automatically selects the best refresh rate based on the loaded content. 'NTSC (60 Hz)' forces 60 Hz. 'PAL (50 Hz)' forces 50 Hz."
msgstr "Vyberte obnovovací frekvenci použitou při emulaci. „Automaticky“ vybere nejlepší frekvenci podle načteného obsahu. „NTSC (60 Hz)“ vynutí 60 Hz. „PAL (50 Hz)“ vynutí 50 Hz."

msgctxt "#30014"
msgid "Select which mapper (memory bank controller) is emulated. 'Auto' automatically detects the appropriate mapper based on the loaded content. Only change this if a game does not work correctly with the default setting."
msgstr "Vyberte emulovaný mapper (řadič paměťových bank). „Automaticky“ detekuje vhodný mapper podle načteného obsahu. Toto nastavení měňte pouze tehdy, když hra s výchozím nastavením nefunguje správně."

msgctxt "#30015"
msgid "Video"
msgstr "Video"

msgctxt "#30016"
msgid "Configure aspect ratio, overscan and sprite settings."
msgstr "Nastaví poměr stran, overscan a sprity."

msgctxt "#30017"
msgid "Select which aspect ratio will be presented by the core. '1:1 PAR' selects an aspect ratio that produces square pixels."
msgstr "Vyberte poměr stran použitý jádrem. „1:1 PAR“ vybere poměr stran vytvářející čtvercové pixely."

msgctxt "#30019"
msgid "Remove the per-line sprite limit. This reduces flickering but may cause glitches in certain games. It's best to keep this option disabled."
msgstr "Odstraní limit spritů na řádek. Tím se omezí blikání, ale v některých hrách to může způsobit chyby. Nejlepší je ponechat tuto volbu vypnutou."

msgctxt "#30020"
msgid "Input"
msgstr "Vstup"

msgctxt "#30021"
msgid "Configure controller behavior, spinner support and sensitivity settings."
msgstr "Nastaví chování ovladače, podporu spinneru a citlivost."

msgctxt "#30022"
msgid "Allow pressing, quickly alternating, or holding both left and right (or up and down) directions at the same time. This may cause movement based glitches in certain games."
msgstr "Umožní současné stisknutí, rychlé střídání nebo podržení směrů doleva a doprava (nebo nahoru a dolů). V některých hrách to může způsobit chyby pohybu."

msgctxt "#30023"
msgid "Select which spinner controller will be emulated. Spinners are controlled by mouse movement. Mouse buttons are mapped to Left (Yellow) and Right (Red) buttons."
msgstr "Vyberte emulovaný spinner ovladač. Spinner se ovládá pohybem myši. Tlačítka myši jsou namapována na tlačítka doleva (žluté) a doprava (červené)."

msgctxt "#30024"
msgid "Set the sensitivity of the spinner controller. 1 is the lowest sensitivity and 10 is the highest."
msgstr "Nastaví citlivost spinner ovladače. 1 je nejnižší citlivost a 10 nejvyšší."

msgctxt "#30025"
msgid "NTSC (60 Hz)"
msgstr "NTSC (60 Hz)"

msgctxt "#30026"
msgid "PAL (50 Hz)"
msgstr "PAL (50 Hz)"

msgctxt "#30027"
msgid "Standard"
msgstr "Standardní"

msgctxt "#30028"
msgid "MegaCart"
msgstr "MegaCart"

msgctxt "#30029"
msgid "Activision"
msgstr "Activision"

msgctxt "#30030"
msgid "OCM"
msgstr "OCM"

msgctxt "#30031"
msgid "Top+Bottom"
msgstr "Nahoře+dole"

msgctxt "#30032"
msgid "Full (284 width)"
msgstr "Plný (šířka 284)"

msgctxt "#30033"
msgid "Full (320 width)"
msgstr "Plný (šířka 320)"

msgctxt "#30034"
msgid "Super Action Controller"
msgstr "Super Action Controller"

msgctxt "#30035"
msgid "Wheel Controller"
msgstr "Ovladač s volantem"

msgctxt "#30036"
msgid "Roller Controller"
msgstr "Ovladač Roller"

msgctxt "#30037"
msgid "Video Chip (restart)"
msgstr "Videočip (vyžaduje restart)"

msgctxt "#30038"
msgid "Select the installed video chip. 'Auto' uses TMS9918A unless the loaded game database entry requires F18A. Changes take effect when content is restarted."
msgstr "Vyberte nainstalovaný videočip. „Automaticky“ použije TMS9918A, pokud záznam načtené hry v databázi vyžaduje F18A. Změny se projeví po restartování obsahu."

msgctxt "#30039"
msgid "TMS9918A"
msgstr "TMS9918A"

msgctxt "#30040"
msgid "F18A"
msgstr "F18A"

msgctxt "#30041"
msgid "Select which overscan (borders) will be used in TMS9918A emulation. 'Disabled' shows no overscan. 'Top+Bottom' enables vertical overscan only. 'Full (284 width)' and 'Full (320 width)' enable full overscan with different horizontal widths. F18A output uses its active logical raster without TMS overscan."
msgstr "Vyberte, který overscan (okraje) se použije při emulaci TMS9918A. „Zakázáno“ nezobrazí žádný overscan. „Nahoře+dole“ povolí pouze svislý overscan. „Plný (šířka 284)“ a „Plný (šířka 320)“ povolí úplný overscan s různými vodorovnými šířkami. Výstup F18A používá aktivní logický rastr bez overscanu TMS."

#~ msgctxt "#30018"
#~ msgid "Select which overscan (borders) will be used in emulation. 'Disabled' shows no overscan. 'Top+Bottom' enables vertical overscan only. 'Full (284 width)' and 'Full (320 width)' enable full overscan with different horizontal widths."
