msgctxt "Addon Summary"
msgid "Coleco - ColecoVision (Gearcoleco)"
msgstr "Coleco - ColecoVision (Gearcoleco)"

msgctxt "Addon Description"
msgid "Gearcoleco is an open source, cross-platform, ColecoVision emulator."
msgstr "Gearcoleco es un emulador de ColecoVision de código abierto y multiplataforma."

msgctxt "#30001"
msgid "Refresh Rate (restart)"
msgstr "Tasa de Refresco (reiniciar)"

msgctxt "#30002"
msgid "Allow Up+Down / Left+Right"
msgstr "Permitir Arriba+Abajo / Izquierda+Derecha"

msgctxt "#30003"
msgid "No Sprite Limit"
msgstr "Sin Límite de Sprites"

msgctxt "#30005"
msgid "Overscan"
msgstr "Overscan"

msgctxt "#30007"
msgid "Spinner Sensitivity"
msgstr "Sensibilidad de giro"

msgctxt "#30008"
msgid "Aspect Ratio"
msgstr "Relación de Aspecto"

msgctxt "#30009"
msgid "Spinner Support"
msgstr "Soporte Spinner"

msgctxt "#30010"
msgid "Mapper (restart)"
msgstr "Mapeador (reinicio)"

msgctxt "#30011"
msgid "System"
msgstr ""

msgctxt "#30012"
msgid "Configure refresh rate and other system-level settings."
msgstr ""

msgctxt "#30013"
msgid "Select which refresh rate will be used in emulation. 'Auto' automatically selects the best refresh rate based on the loaded content. 'NTSC (60 Hz)' forces 60 Hz. 'PAL (50 Hz)' forces 50 Hz."
msgstr ""

msgctxt "#30014"
msgid "Select which mapper (memory bank controller) is emulated. 'Auto' automatically detects the appropriate mapper based on the loaded content. Only change this if a game does not work correctly with the default setting."
msgstr ""

msgctxt "#30015"
msgid "Video"
msgstr ""

msgctxt "#30016"
msgid "Configure aspect ratio, overscan and sprite settings."
msgstr ""

msgctxt "#30017"
msgid "Select which aspect ratio will be presented by the core. '1:1 PAR' selects an aspect ratio that produces square pixels."
msgstr ""

msgctxt "#30018"
msgid "Select which overscan (borders) will be used in emulation. 'Disabled' shows no overscan. 'Top+Bottom' enables vertical overscan only. 'Full (284 width)' and 'Full (320 width)' enable full overscan with different horizontal widths."
msgstr ""

msgctxt "#30019"
msgid "Remove the per-line sprite limit. This reduces flickering but may cause glitches in certain games. It's best to keep this option disabled."
msgstr ""

msgctxt "#30020"
msgid "Input"
msgstr ""

msgctxt "#30021"
msgid "Configure controller behavior, spinner support and sensitivity settings."
msgstr ""

msgctxt "#30022"
msgid "Allow pressing, quickly alternating, or holding both left and right (or up and down) directions at the same time. This may cause movement based glitches in certain games."
msgstr ""

msgctxt "#30023"
msgid "Select which spinner controller will be emulated. Spinners are controlled by mouse movement. Mouse buttons are mapped to Left (Yellow) and Right (Red) buttons."
msgstr ""

msgctxt "#30024"
msgid "Set the sensitivity of the spinner controller. 1 is the lowest sensitivity and 10 is the highest."
msgstr ""

#~ msgctxt "#30006"
#~ msgid "Spinner support"
#~ msgstr "Soporte giratorio"

#~ msgctxt "#30004"
#~ msgid "Aspect Ratio (restart)"
#~ msgstr "Relación de aspecto (reiniciar)"

#~ msgctxt "#30000"
#~ msgid "Settings"
#~ msgstr "Ajustes"
